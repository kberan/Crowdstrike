Example parser structure for syslog format:
// Parse raw log format
| @rawstring=/^<(?<facility_priority>\d+)>: (?\d{4}\s+\w+\s+\d{1,2}\s+\d{2}:\d{2}:\d{2}\s+\w+): %(?[^-]+)-(?\d+)-(?<msg_type>[^:]+): (?.+)/

// Extract fields
| message=/(?<msg_content>.*?)(?:\s+-\s+(?<process_name>[^[]+)(?:[(?<process_id>\d+)])?)?$/

// Map to CPS fields
| event.type:="network"
| event.category:="network"
| event.kind:="event"
| process.name:=process_name
| process.pid:=process_id

// Set metadata
| Parser.version:="1.0.0"
| Cps.version:="1.0.0"
| ecs.version:="8.0.0"
| Vendor:="cisco"

// Format timestamp
| findTimestamp(field=timestamp)
| drop([timestamp])


